{
  "appId": "com.androidcontrolcenter.app",
  "productName": "Android Control Center",
  "copyright": "Copyright © 2026 Android Control Center Contributors",
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist/**/*", "dist-electron/**/*"],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis"]
  },
  "linux": {
    "target": ["AppImage", "deb", "tar.gz"],
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": true,
    "include": "build/installer.nsh"
  }
}
